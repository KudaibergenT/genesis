{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings.json (submit)",
  "description": "Structural contract only: a valid structure with a wrong type, ids, currency or amount is an FP, not a structural error. Unknown extra keys are ignored.",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claimed_amount_minor": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "episode_id",
    "findings"
  ],
  "additionalProperties": true
}
