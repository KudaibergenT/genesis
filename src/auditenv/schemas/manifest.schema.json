{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "generator_version": {
      "type": "string"
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "base_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "period_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "period_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review_window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string"
    },
    "utc_offset": {
      "type": "string",
      "pattern": "^[+-]\\d{2}:\\d{2}$"
    },
    "counts": {
      "type": "object",
      "properties": {
        "ledger_rows": {
          "type": "integer",
          "minimum": 0
        },
        "invoices": {
          "type": "integer",
          "minimum": 0
        },
        "payments": {
          "type": "integer",
          "minimum": 0
        },
        "documents": {
          "type": "integer",
          "minimum": 0
        },
        "fx_rates": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ledger_rows",
        "invoices",
        "payments",
        "documents",
        "fx_rates"
      ],
      "additionalProperties": false
    },
    "rounding": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "ROUND_HALF_EVEN",
            "ROUND_HALF_UP"
          ]
        },
        "unit": {
          "const": "minor"
        }
      },
      "required": [
        "mode",
        "unit"
      ],
      "additionalProperties": false
    },
    "currency_exponents": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "money_format": {
      "type": "string"
    },
    "null_representation": {
      "type": "string"
    },
    "time_format": {
      "type": "string"
    },
    "synthetic_data": {
      "type": "string"
    },
    "issue_types": {
      "type": "array",
      "items": {
        "enum": [
          "duplicate_invoice",
          "payment_allocation",
          "fx_conversion",
          "period_cutoff"
        ]
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "episode_id",
    "generator_version",
    "company",
    "base_currency",
    "period_start",
    "period_end",
    "review_window_end",
    "timezone",
    "utc_offset",
    "counts",
    "rounding",
    "currency_exponents",
    "money_format",
    "null_representation",
    "time_format",
    "synthetic_data",
    "issue_types",
    "files"
  ],
  "additionalProperties": false
}
