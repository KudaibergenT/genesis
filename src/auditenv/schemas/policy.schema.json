{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "ledger": {
      "type": "object",
      "required": [
        "currency",
        "accounts",
        "null_references"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "accounts": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "cash",
              "ar",
              "unapplied",
              "equity",
              "revenue",
              "returns",
              "fx"
            ]
          }
        }
      }
    },
    "fx": {
      "type": "object",
      "required": [
        "quote",
        "rate_date",
        "missing_date",
        "conversion"
      ]
    },
    "rounding": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "ROUND_HALF_EVEN",
            "ROUND_HALF_UP"
          ]
        }
      }
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end",
        "timezone",
        "boundary",
        "review_window_end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "review_window_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "allocation": {
      "type": "object"
    },
    "issue_conventions": {
      "type": "object",
      "properties": {
        "duplicate_invoice": {
          "type": "object",
          "properties": {
            "affected_ids": {
              "type": "string"
            },
            "amount": {
              "type": "string"
            },
            "currency": {
              "type": "string"
            },
            "tolerance_minor": {
              "type": "integer",
              "minimum": 0
            },
            "evidence": {
              "type": "string"
            }
          },
          "required": [
            "affected_ids",
            "amount",
            "currency",
            "tolerance_minor",
            "evidence"
          ],
          "additionalProperties": false
        },
        "payment_allocation": {
          "type": "object",
          "properties": {
            "affected_ids": {
              "type": "string"
            },
            "amount": {
              "type": "string"
            },
            "currency": {
              "type": "string"
            },
            "tolerance_minor": {
              "type": "integer",
              "minimum": 0
            },
            "evidence": {
              "type": "string"
            }
          },
          "required": [
            "affected_ids",
            "amount",
            "currency",
            "tolerance_minor",
            "evidence"
          ],
          "additionalProperties": false
        },
        "fx_conversion": {
          "type": "object",
          "properties": {
            "affected_ids": {
              "type": "string"
            },
            "amount": {
              "type": "string"
            },
            "currency": {
              "type": "string"
            },
            "tolerance_minor": {
              "type": "integer",
              "minimum": 0
            },
            "evidence": {
              "type": "string"
            }
          },
          "required": [
            "affected_ids",
            "amount",
            "currency",
            "tolerance_minor",
            "evidence"
          ],
          "additionalProperties": false
        },
        "period_cutoff": {
          "type": "object",
          "properties": {
            "affected_ids": {
              "type": "string"
            },
            "amount": {
              "type": "string"
            },
            "currency": {
              "type": "string"
            },
            "tolerance_minor": {
              "type": "integer",
              "minimum": 0
            },
            "evidence": {
              "type": "string"
            }
          },
          "required": [
            "affected_ids",
            "amount",
            "currency",
            "tolerance_minor",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "duplicate_invoice",
        "payment_allocation",
        "fx_conversion",
        "period_cutoff"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "ledger",
    "fx",
    "rounding",
    "period",
    "allocation",
    "issue_conventions"
  ],
  "additionalProperties": false
}
