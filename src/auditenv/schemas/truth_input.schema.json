{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "truth.json accepted by the evaluator",
  "description": "Minimum = the fields of case section 03. tolerance_minor absent -> 0 (jury default). episode_id absent -> taken from manifest.json. A bare list of issues is accepted.",
  "$defs": {
    "issue": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "affected_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_amount_minor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "tolerance_minor": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "issue_id",
        "type",
        "affected_ids",
        "expected_amount_minor",
        "currency",
        "evidence_sets"
      ],
      "additionalProperties": true
    },
    "truth_object": {
      "type": "object",
      "required": [
        "issues"
      ],
      "additionalProperties": true,
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    {
      "$ref": "#/$defs/truth_object"
    }
  ]
}
